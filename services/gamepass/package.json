{
  "name": "chess-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "catan:selfplay": "tsx scripts/catan-selfplay.ts",
    "telegram:webhook:set": "tsx scripts/set-telegram-webhook.ts",
    "checkers:selfplay": "tsx scripts/checkers-selfplay.ts",
    "bunker:selfplay": "tsx scripts/bunker-selfplay.ts",
    "tabletop:selfplay": "tsx scripts/tabletop-selfplay.ts",
    "bunker:e2e": "tsx scripts/bunker-e2e.ts",
    "catan:e2e": "tsx scripts/catan-e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "chess.js": "^1.0.0-beta.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
